{
  "name": "msnwidget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "./dist-lib/msnwidget.js",
  "exports": {
    ".": "./dist-lib/msnwidget.js",
    "./core": "./src/network.js",
    "./style.css": "./dist-lib/msnwidget.css"
  },
  "files": [
    "dist-lib",
    "src/network.js"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "vite build --mode library",
    "test": "node --test tests/network.test.js",
    "test:browser": "npm run build:lib && playwright test",
    "prepack": "npm run build:lib"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@gmod/vcf": "^7.2.0",
    "d3": "^7.9.0",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.8.1"
  }
}
